// Konfiguracja Cloudflare Workers: strona z katalogu public/ + logika w worker/index.js
{
  "name": "ponglisz",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // worker sprawdza logowanie przed podaniem jakiegokolwiek pliku
    "run_worker_first": true
  },
  // zmienne ustawione w panelu Cloudflare nie znikają przy kolejnych wdrożeniach
  "keep_vars": true,
  // baza z postępami Jany i Dominika
  "d1_databases": [
    { "binding": "DB", "database_name": "ponglisz", "database_id": "4bb583ef-f37a-40e2-80d1-a9ff2cf17fb9" }
  ],
  "observability": { "enabled": true }
}
